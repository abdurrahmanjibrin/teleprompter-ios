<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>Teleprompter Pro</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>com.teleprompter.iphone15</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    
    <!-- Izin Kamera -->
    <key>NSCameraUsageDescription</key>
    <string>Aplikasi memerlukan akses kamera untuk merekam video berkualitas tinggi dengan teleprompter.</string>
    
    <!-- Izin Mikrofon -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Aplikasi memerlukan mikrofon untuk merekam audio video serta fitur Voice Tracking naskah otomatis.</string>
    
    <!-- Izin Pengenalan Suara (Speech Recognition) -->
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Aplikasi menggunakan pengenalan suara agar teks teleprompter bergeser otomatis mengikuti kecepatan Anda berbicara.</string>
    
    <!-- Izin Simpan ke Galeri Foto -->
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Aplikasi memerlukan izin untuk menyimpan video hasil rekaman ke galeri foto iPhone Anda.</string>
    
    <!-- Mode Background untuk Picture-in-Picture -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>
    
    <key>UILaunchScreen</key>
    <dict/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
</dict>
</plist>

